# ==============================================================================
# EPI Central Admin Environment Configuration
# ==============================================================================

# Server Port (Local dev default: 5050)
PORT=5050
NODE_ENV=production

# JWT Authentication Secret (Required for production: minimum 32 random characters)
JWT_SECRET=your_secure_jwt_secret_here

# MongoDB Connection (Required for Vercel production persistence, e.g., MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/epi_central?retryWrites=true&w=majority
MONGODB_DB_NAME=epi_central

# Department URLs (Vercel deployment URLs or custom domains)
# Optional in local dev: defaults to http://localhost:5173, :5174, :5175
VITE_SALES_URL=https://your-sales-app.vercel.app
VITE_SERVICE_URL=https://your-service-app.vercel.app
VITE_ACCOUNTS_URL=https://your-accounts-app.vercel.app
