# ==============================================================================
# EPI CENTRALIZED MANAGEMENT SYSTEM — MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Note: Never commit actual .env files containing real secrets to GitHub.
# Configure these variables in your Vercel Dashboard for each respective project.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EPI CENTRAL ADMIN (Project: epi-central-admin)
# ------------------------------------------------------------------------------
PORT=5050
NODE_ENV=production
JWT_SECRET=your_secure_central_jwt_secret_32_chars_min
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/epi_central?retryWrites=true&w=majority
MONGODB_DB_NAME=epi_central

# Department Production URLs (Set in Vercel project settings for Central Admin)
VITE_SALES_URL=https://epi-sales.vercel.app
VITE_SERVICE_URL=https://epi-service.vercel.app
VITE_ACCOUNTS_URL=https://epi-erp.vercel.app

# ------------------------------------------------------------------------------
# 2. EPI SALES DEPARTMENT (Project: epi-sales)
# ------------------------------------------------------------------------------
# Set in Vercel project settings for Sales
VITE_CENTRAL_URL=https://epi-central-admin.vercel.app

# ------------------------------------------------------------------------------
# 3. EPI SERVICE DEPARTMENT (Project: epi-service)
# ------------------------------------------------------------------------------
# Set in Vercel project settings for Service
VITE_CENTRAL_URL=https://epi-central-admin.vercel.app

# ------------------------------------------------------------------------------
# 4. EPI ACCOUNTS DEPARTMENT (Project: epi-erp)
# ------------------------------------------------------------------------------
# Set in Vercel project settings for Accounts ERP
VITE_CENTRAL_URL=https://epi-central-admin.vercel.app
VITE_API_URL=/api
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/epi_erp?retryWrites=true&w=majority
JWT_SECRET=your_secure_erp_jwt_secret_32_chars_min
