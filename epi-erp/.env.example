# ==============================================================================
# EPI Accounts Department (ERP) — Environment Configuration
# ==============================================================================

# Central Admin Portal URL (For SSO ticket exchange & navigation)
# In local development: defaults to http://localhost:5050
# In production on Vercel: set to your deployed Central Portal URL
VITE_CENTRAL_URL=https://your-central-admin.vercel.app

# API URL (Optional: defaults to /api when frontend and backend are deployed together on Vercel)
VITE_API_URL=/api

# MongoDB Atlas Connection URI (Required for permanent accounting records in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/epi_erp?retryWrites=true&w=majority

# JWT Secret Key (Required for production: minimum 32 random characters)
JWT_SECRET=your_secure_erp_jwt_secret_here

# Initial Admin Seeding (Optional)
ADMIN_EMAIL=admin@epiups.com.bd
ADMIN_PASSWORD=your_secure_admin_password_here
